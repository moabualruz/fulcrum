#!/usr/bin/env sh
SCRIPT=$(readlink -f "$0")
DIR=$(dirname "$SCRIPT")

# ONNX Runtime CUDA provider dlopens CUDA/cuDNN libraries at model load time.
# LD_LIBRARY_PATH must be set before Node starts; setting it inside TS is too late.
CUDA_LIB_DIRS="/usr/local/cuda/lib64:/usr/local/cuda/targets/x86_64-linux/lib:/usr/local/lib/ollama/cuda_v12"
FULCRUM_CUDA_SITE=$(find "$HOME/.local/share/fulcrum/cuda-python/lib" -path '*/site-packages/nvidia/*/lib' -type d 2>/dev/null | paste -sd ':' -)
if [ -n "$FULCRUM_CUDA_SITE" ]; then
  CUDA_LIB_DIRS="$CUDA_LIB_DIRS:$FULCRUM_CUDA_SITE"
fi
PY_CUDA_LIB_DIRS=$(python3 - <<'PY' 2>/dev/null || true
import glob
import site

roots = []
for getter in (site.getusersitepackages,):
    try:
        roots.append(getter())
    except Exception:
        pass
try:
    roots.extend(site.getsitepackages())
except Exception:
    pass

dirs = []
for root in roots:
    dirs.extend(glob.glob(root + "/nvidia/*/lib"))
print(":".join(dirs))
PY
)
if [ -n "$PY_CUDA_LIB_DIRS" ]; then
  CUDA_LIB_DIRS="$CUDA_LIB_DIRS:$PY_CUDA_LIB_DIRS"
fi
export LD_LIBRARY_PATH="$CUDA_LIB_DIRS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$DIR/node_modules/.bin/tsx" "$DIR/packages/cli/src/index.ts" "$@"
