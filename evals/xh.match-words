# match-words for xh
# why "xh" alone excluded: too short; flags provide the needed specificity
xh --check-status
xh -b
xh -h
xh -f
xh --auth
xh --download
xh --auth-type=bearer
xh --multipart
xh --form
xh GET
xh POST
xh PUT
xh DELETE
xh PATCH
xh HEAD
xh --session
xh --json
xh --pretty
xh --verify
xh https
xh -d
