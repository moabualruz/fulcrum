{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"cookie": "^0.7.2"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test --conditions=svelte ./src/lib",
		"web:test": "vitest run",
		"web:e2e": "bun run web:e2e:full",
		"web:e2e:smoke": "playwright test tests/e2e/_smoke.spec.ts",
		"web:e2e:full": "playwright test tests/e2e/",
		"web:a11y": "playwright test tests/a11y/ --project=chromium",
		"i18n:extract": "bun run src/lib/i18n/extract.ts"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.0",
