		"@sveltejs/kit": "^2.59.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/svelte": "^5.3.1",
		"@types/bun": "^1.3.13",
		"@types/dompurify": "^3.2.0",
		"@types/marked": "^6.0.0",
		"@vitest/expect": "^4.1.5",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"happy-dom": "20.9.0",
		"jsdom": "^29.1.1",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
