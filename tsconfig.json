{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "lib": ["ESNext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@fulcrum/cli/*": ["apps/cli/src/*"],
      "@fulcrum/tui/*": ["apps/tui/src/*"],
      "@fulcrum/server/*": ["apps/server/src/*"],
      "@fulcrum/web/*": ["apps/web/src/*"]
    },
    "experimentalDecorators": false,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "apps/cli/src/**/*.ts", "apps/tui/src/**/*.ts", "apps/server/src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/web/**"]
}
