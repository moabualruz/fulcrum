{
  "name": "fulcrum",
  "version": "0.1.0",
  "description": "Multi-agent foundation CLI — hooks, skills, rules across Claude Code, Codex, Gemini, OpenCode, Pi.",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "cookie": "^0.7.2",
    "effect": "3.20.0"
  },
  "module": "apps/cli/src/main.ts",
  "bin": {
    "fulcrum": "apps/cli/src/main.ts"
  },
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "build": "bun build --compile --minify --target=bun-darwin-arm64 apps/cli/src/main.ts --outfile=dist/fulcrum-darwin-arm64",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "lint": "bun run --bun tsc --noEmit",
    "lint:boundaries": "bun run scripts/check-module-boundaries.ts",
    "ci": "bun run scripts/ci.ts",
    "changelog": "git-cliff -o CHANGELOG.md",
    "compress": "bun run apps/cli/src/main.ts compress",
    "release": "bun run scripts/release.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.59.1",
    "@readme/openapi-parser": "6.1.0",
    "@types/bun": "latest",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "svelte": "^5.55.2",
    "tinyglobby": "0.2.16",
    "ts-morph": "28.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.5.6",
    "@effect/platform": "0.95.0",
    "@effect/platform-node": "0.105.0",
    "@electric-sql/pglite": "0.4.5",
    "@hono/zod-openapi": "1.3.0",
    "@better-auth/core": "1.4.7",
    "@mikro-orm/core": "7.0.14",
    "@mikro-orm/decorators": "7.0.14",
    "@mikro-orm/migrations": "7.0.14",
    "@mikro-orm/postgresql": "7.0.14",
    "@needle-di/core": "1.1.2",
    "@tiptap/pm": "3.22.5",
    "@trpc/server": "11.7.2",
    "asciichart": "1.5.25",
    "better-auth": "1.4.7",
    "casbin": "5.44.0",
    "effect": "3.20.0",
    "hono": "4.12.16",
    "json-rules-engine": "7.3.1",
    "kysely": "0.28.17",
    "liquidjs": "10.24.0",
    "mime-types": "3.0.2",
    "nodemailer": "8.0.7",
    "pg": "8.20.0",
    "picocolors": "1.1.1",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-stringify": "11.0.0",
    "smol-toml": "^1.4.2",
    "simple-git": "3.30.0",
    "tweetnacl": "1.0.3",
    "unified": "11.0.5",
    "web-push": "3.6.7",
    "ws": "8.18.3",
    "yaml": "2.8.3",
    "yjs": "13.6.30",
    "zod": "4.4.2",
    "zustand": "5.0.12",
    "@opentui/core": "0.2.2",
    "@opentui/solid": "0.2.2"
  }
}
