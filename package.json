{
  "name": "fulcrum",
  "version": "0.0.3",
  "private": true,
  "description": "Local-first agent control plane — task tracking, WIP enforcement, human-readable memory vault (L0) + hybrid recall (L1 FTS5 + L2 Kuzu graph), and CoS context for multi-agent TypeScript systems",
  "keywords": [
    "agent-os",
    "multi-agent",
    "sqlite",
    "local-first",
    "llm",
    "ai-agents",
    "task-management",
    "typescript",
    "vault",
    "kuzu",
    "graph-database",
    "entity-graph",
    "knowledge-graph"
  ],
  "author": "Mo Abualruz <moabualruz@github>",
  "license": "MIT",
  "homepage": "https://github.com/moabualruz/fulcrum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/fulcrum.git"
  },
  "bugs": {
    "url": "https://github.com/moabualruz/fulcrum/issues"
  },
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check:cycles": "node --import tsx/esm scripts/check-cycles.ts",
    "gen:agent-mds": "node --import tsx/esm scripts/gen-agent-mds.ts",
    "gen:claude-md": "node --import tsx/esm scripts/gen-claude-md.ts",
    "check:claude-md": "node --import tsx/esm scripts/gen-claude-md.ts --check",
    "fulcrum": "node --import tsx/esm packages/cli/src/index.ts",
    "install-bin": "mkdir -p $HOME/.local/bin && ln -sf $(pwd)/fulcrum $HOME/.local/bin/fulcrum && echo 'fulcrum → ~/.local/bin/fulcrum'",
    "setup": "node --import tsx/esm agent-integration/install.ts all",
    "setup:claude": "node --import tsx/esm agent-integration/install.ts claude",
    "setup:gemini": "node --import tsx/esm agent-integration/install.ts gemini",
    "setup:pi": "node --import tsx/esm agent-integration/install.ts pi",
    "setup:check": "node --import tsx/esm agent-integration/install.ts check",
    "setup:dry": "node --import tsx/esm agent-integration/install.ts all --dry-run",
    "publish:all": "pnpm build && pnpm -r --filter \"./packages/**\" publish --access public --no-git-checks",
    "publish:dry": "pnpm build && pnpm -r --filter \"./packages/**\" publish --access public --no-git-checks --dry-run"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "onnxruntime-node",
      "koffi",
      "protobufjs",
      "kuzu"
    ]
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
