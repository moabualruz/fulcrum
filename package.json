{
  "name": "fulcrum",
  "version": "0.1.0",
  "description": "Multi-agent foundation CLI — hooks, skills, rules across Claude Code, Codex, Gemini, OpenCode, Pi.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "bin": {
    "fulcrum": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile=dist/fulcrum-darwin-arm64",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "lint": "bun run --bun tsc --noEmit",
    "lint:boundaries": "bun run scripts/check-module-boundaries.ts",
    "ci": "bun run scripts/ci.ts",
    "changelog": "git-cliff -o CHANGELOG.md",
    "compress": "bun run src/index.ts compress",
    "release": "bun run scripts/release.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.59.1",
    "@readme/openapi-parser": "6.1.0",
    "@types/bun": "latest",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.5.6",
    "@effect/platform": "0.95.0",
    "@effect/platform-node": "0.105.0",
    "@electric-sql/pglite": "0.4.5",
    "@hono/zod-openapi": "1.3.0",
    "@tiptap/pm": "3.22.5",
    "asciichart": "1.5.25",
    "effect": "3.20.0",
    "hono": "4.12.16",
    "nodemailer": "8.0.7",
    "pg": "8.20.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-stringify": "11.0.0",
    "smol-toml": "^1.4.2",
    "unified": "11.0.5",
    "web-push": "3.6.7",
    "ws": "8.18.3",
    "yaml": "2.8.3",
    "yjs": "13.6.30",
    "zod": "4.4.2",
    "zustand": "5.0.12"
  }
}
