{
  "name": "fulcrum",
  "version": "0.1.0",
  "description": "Multi-agent foundation CLI — hooks, skills, rules across Claude Code, Codex, Gemini, OpenCode, Pi.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "bin": {
    "fulcrum": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile=dist/fulcrum-darwin-arm64",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "lint": "bun run --bun tsc --noEmit",
    "ci": "bun run scripts/ci.ts",
    "changelog": "git-cliff -o CHANGELOG.md",
    "compress": "bun run src/index.ts compress",
    "release": "bun run scripts/release.ts",
    "db:migrate": "mikro-orm migration:up"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "8.20.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@mikro-orm/core": "7.0.13",
    "@mikro-orm/migrations": "7.0.13",
    "@mikro-orm/postgresql": "7.0.13",
    "@needle-di/core": "1.1.2",
    "mikro-orm-pglite": "0.5.1",
    "pg": "8.20.0",
    "smol-toml": "^1.4.2",
    "yaml": "2.8.3",
    "zustand": "5.0.12"
  }
}
