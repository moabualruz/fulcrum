{
  "name": "fulcrum-sync",
  "version": "0.0.1",
  "description": "Bidirectional sync adapter \u2014 Plane project management integration, conflict detection, and sync state management",
  "keywords": [
    "sync",
    "plane",
    "project-management",
    "bidirectional-sync",
    "conflict-detection",
    "integration"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "fulcrum-core": "workspace:*",
    "fulcrum-policy": "workspace:*",
    "ulidx": "^2.3.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
