{
  "name": "@moabualruz/fulcrum-core",
  "version": "0.0.1",
  "description": "Core persistence and orchestration layer \u2014 SQLite tasks, agent runs, policy enforcement, workspace status, handoffs, events, and embedding providers",
  "keywords": [
    "agent-os",
    "tasks",
    "sqlite",
    "policy",
    "embeddings",
    "handoffs",
    "agent-lifecycle",
    "wip-limits"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "sqlite-vec": "^0.1.6",
    "@huggingface/transformers": "^3.0.0",
    "ulidx": "^2.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0"
  },
  "devDependencies": {
    "@moabualruz/fulcrum-teams": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
