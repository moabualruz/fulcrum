{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "declarationMap": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "../.."
  },
  "include": ["src/**/*", "../../agent-integration/install.ts"],
  "exclude": ["node_modules", "dist"]
}
