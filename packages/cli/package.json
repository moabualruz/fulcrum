{
  "name": "fulcrum-cli",
  "version": "0.0.1",
  "description": "CLI for Fulcrum — fulcrum memory init, accelerate, rebuild, status",
  "keywords": [
    "cli",
    "agent-os",
    "fulcrum",
    "memory",
    "vault"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "fulcrum": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --import tsx/esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fulcrum-core": "workspace:*",
    "fulcrum-memory": "workspace:*",
    "fulcrum-monitor": "workspace:*",
    "fulcrum-planning": "workspace:*",
    "fulcrum-policy": "workspace:*",
    "fulcrum-sync": "workspace:*",
    "fulcrum-teams": "workspace:*",
    "fulcrum-worker": "workspace:*",
    "fulcrum-workflows": "workspace:*",
    "fulcrum-worktrees": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.0.0",
    "react": "^19.2.5",
    "tsx": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "better-sqlite3": "^12.9.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
