{
  "name": "@fulcrum/teams",
  "version": "0.0.1",
  "description": "Agent team orchestration \u2014 team templates, role slots, communication and budget policies, team spawning",
  "keywords": [
    "teams",
    "agent-orchestration",
    "team-templates",
    "multi-agent",
    "role-slots",
    "policies"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "@fulcrum/core": "workspace:*",
    "ulidx": "^2.0.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
