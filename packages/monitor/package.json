{
  "name": "fulcrum-monitor",
  "version": "0.0.1",
  "description": "Real-time metrics dashboard \u2014 daily, project, and agent metrics, burndown data, HTTP monitoring server",
  "keywords": [
    "metrics",
    "monitoring",
    "dashboard",
    "burndown",
    "agent-metrics",
    "http-server"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "fulcrum-core": "workspace:*",
    "fulcrum-memory": "workspace:*",
    "fulcrum-policy": "workspace:*",
    "ulidx": "^2.3.0",
    "hono": "^4.4.0",
    "@hono/node-server": "^1.12.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
