{
  "name": "fulcrum-mcp",
  "version": "0.0.3",
  "description": "Zero-install MCP server for Fulcrum agent OS — run with npx fulcrum-mcp or add to Claude Desktop config",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-os",
    "fulcrum",
    "claude",
    "ai"
  ],
  "type": "module",
  "bin": {
    "fulcrum-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --outDir dist --declaration",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "fulcrum-agent-cli": "workspace:*",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "readme": "README.md",
  "author": "Mo Abualruz <moabualruz@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/fulcrum.git"
  },
  "homepage": "https://github.com/moabualruz/fulcrum#readme",
  "bugs": {
    "url": "https://github.com/moabualruz/fulcrum/issues"
  }
}
