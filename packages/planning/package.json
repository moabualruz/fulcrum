{
  "name": "@fulcrum/planning",
  "version": "0.0.1",
  "description": "Project planning domain — epics, issues, PRDs, plans, task relations, and code review workflows",
  "keywords": [
    "planning",
    "epics",
    "issues",
    "prd",
    "code-review",
    "task-relations",
    "project-management"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@fulcrum/core": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
