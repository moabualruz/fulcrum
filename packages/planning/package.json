{
  "name": "@fulcrum/planning",
  "version": "0.0.1",
  "description": "Project planning domain \u2014 epics, issues, PRDs, plans, task relations, and code review workflows",
  "keywords": [
    "planning",
    "epics",
    "issues",
    "prd",
    "code-review",
    "task-relations",
    "project-management"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "@fulcrum/core": "workspace:*",
    "ulidx": "^2.3.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
