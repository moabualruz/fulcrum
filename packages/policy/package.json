{
  "name": "fulcrum-policy",
  "version": "0.0.2",
  "description": "Policy engine — system invariants, custom rule evaluation, secret guard (detect and redact), and audit logging",
  "keywords": [
    "policy",
    "security",
    "secret-detection",
    "audit-log",
    "invariants",
    "access-control"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "fulcrum-agent-core": "workspace:*",
    "minimatch": "^10.2.5",
    "ulidx": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "author": "Mo Abualruz <moabualruz@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/fulcrum.git"
  },
  "homepage": "https://github.com/moabualruz/fulcrum#readme",
  "bugs": {
    "url": "https://github.com/moabualruz/fulcrum/issues"
  }
}
