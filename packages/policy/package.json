{
  "name": "@moabualruz/fulcrum-policy",
  "version": "0.0.1",
  "description": "Policy engine \u2014 system invariants, custom rule evaluation, secret guard (detect and redact), and audit logging",
  "keywords": [
    "policy",
    "security",
    "secret-detection",
    "audit-log",
    "invariants",
    "access-control"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "@moabualruz/fulcrum-core": "workspace:*",
    "minimatch": "^10.2.5",
    "ulidx": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
