{
  "name": "@fulcrum/memory",
  "version": "0.0.1",
  "description": "Three-layer memory stack \u2014 git vault (L0), FTS5 full-text search (L1), Kuzu graph + HNSW vector search (L2) for agent memory and cross-project knowledge graphs",
  "keywords": [
    "memory",
    "vault",
    "graph",
    "kuzu",
    "entity-graph",
    "vector-search",
    "hnsw",
    "agent-memory",
    "knowledge-graph",
    "git"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "@fulcrum/core": "workspace:*",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.22.0",
    "ulidx": "^2.3.0",
    "web-tree-sitter": "^0.26.8"
  },
  "optionalDependencies": {
    "kuzu": "^0.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
