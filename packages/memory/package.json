{
  "name": "fulcrum-memory",
  "version": "0.0.2",
  "description": "Three-layer memory stack — git vault (L0), FTS5 full-text search (L1), Kuzu graph + HNSW vector search (L2) for agent memory and cross-project knowledge graphs",
  "keywords": [
    "memory",
    "vault",
    "graph",
    "kuzu",
    "entity-graph",
    "vector-search",
    "hnsw",
    "agent-memory",
    "knowledge-graph",
    "git"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "eval:fulcrum-recall": "vitest run src/eval/fulcrum-recall/tests/harness.test.ts",
    "eval:longmemeval": "vitest run src/eval/longmemeval/tests/harness.test.ts"
  },
  "dependencies": {
    "fulcrum-agent-core": "workspace:*",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.22.0",
    "ulidx": "^2.3.0",
    "web-tree-sitter": "^0.26.8",
    "xxhash-wasm": "^1.0.2",
    "ignore": "^5.3.1"
  },
  "optionalDependencies": {
    "kuzu": "^0.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "author": "Mo Abualruz <moabualruz@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/fulcrum.git"
  },
  "homepage": "https://github.com/moabualruz/fulcrum#readme",
  "bugs": {
    "url": "https://github.com/moabualruz/fulcrum/issues"
  }
}
