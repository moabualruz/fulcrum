{
  "name": "@fulcrum/workflows",
  "version": "0.0.1",
  "description": "Workflow engine \u2014 define, register, and execute multi-step agent workflows with typed step transitions and run state tracking",
  "keywords": [
    "workflows",
    "workflow-engine",
    "agent-workflows",
    "state-machine",
    "multi-step",
    "orchestration"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "dependencies": {
    "@fulcrum/core": "workspace:*",
    "@fulcrum/memory": "workspace:*",
    "ajv": "^8.18.0",
    "ulidx": "^2.0.0"
  },
  "peerDependencies": {
    "@fulcrum/planning": "workspace:*",
    "@fulcrum/teams": "workspace:*",
    "@fulcrum/worker": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@fulcrum/planning": {
      "optional": true
    },
    "@fulcrum/teams": {
      "optional": true
    },
    "@fulcrum/worker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fulcrum/planning": "workspace:*",
    "@fulcrum/teams": "workspace:*",
    "@fulcrum/worker": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
