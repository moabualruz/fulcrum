{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event pre_tool_use --tool Write"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event pre_tool_use --tool Edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event pre_tool_use --tool Bash"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|MCP",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event pre_tool_use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event post_tool_use --tool Write"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event post_tool_use --tool Edit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event session_start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook copilot --event session_end"
          }
        ]
      }
    ]
  }
}
