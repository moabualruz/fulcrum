{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event pre_tool_use --tool write"
          }
        ]
      },
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event pre_tool_use --tool bash"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|MCP",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event pre_tool_use"
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event post_tool_use --tool write"
          }
        ]
      }
    ],
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event session_start"
          }
        ]
      }
    ],
    "sessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event session_end"
          }
        ]
      }
    ],
    "afterFileEdit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event after_file_edit"
          }
        ]
      }
    ],
    "subagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event subagent_start"
          }
        ]
      }
    ],
    "subagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fulcrum hook cursor --event subagent_stop"
          }
        ]
      }
    ]
  }
}
