{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "fulcrum-session-start",
            "type": "command",
            "command": "fulcrum hook qwen session-start",
            "timeout": 8000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "name": "fulcrum-pre-tool",
            "type": "command",
            "command": "fulcrum hook qwen pre",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "name": "fulcrum-post-tool",
            "type": "command",
            "command": "fulcrum hook qwen post",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "name": "fulcrum-post-tool-failure",
            "type": "command",
            "command": "fulcrum hook qwen post",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "name": "fulcrum-pre-compact",
            "type": "command",
            "command": "fulcrum hook qwen pre-compact",
            "timeout": 5000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "name": "fulcrum-subagent-stop",
            "type": "command",
            "command": "fulcrum hook qwen subagent-stop",
            "timeout": 8000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "fulcrum-session-end",
            "type": "command",
            "command": "fulcrum hook qwen session-end",
            "timeout": 8000
          }
        ]
      }
    ]
  }
}
