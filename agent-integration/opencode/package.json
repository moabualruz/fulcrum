{
  "name": "@fulcrum-agent-os/opencode-plugin",
  "version": "0.0.6",
  "description": "Fulcrum Agent OS — opencode plugin. Injects the canonical Fulcrum-first rider into every LLM turn via experimental.chat.system.transform, with SHA-256 integrity verification and session.idle telemetry for silent-failure detection.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "fulcrum",
    "agent-os",
    "recall-before-grep",
    "system-rider"
  ],
  "type": "module",
  "main": "./plugins/fulcrum.ts",
  "exports": {
    ".": {
      "import": "./plugins/fulcrum.ts"
    },
    "./rider": {
      "import": "./plugins/rider.ts"
    }
  },
  "files": [
    "plugins/fulcrum.ts",
    "plugins/rider.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "pnpm run test",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "git tag -s opencode-plugin/v$(node -p \"require('./package.json').version\") -m \"opencode-plugin v$(node -p \"require('./package.json').version\")\" && git push origin --tags"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "author": "Mo Abualruz <moabualruz@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/fulcrum.git",
    "directory": "agent-integration/opencode"
  },
  "homepage": "https://github.com/moabualruz/fulcrum#readme",
  "bugs": {
    "url": "https://github.com/moabualruz/fulcrum/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
