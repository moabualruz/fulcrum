{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude session-start" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude session-end" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude session-stop" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude subagent-stop" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude pre-compact" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude user-prompt-submit" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude notification" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Task",
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude post" }
        ]
      }
    ]
  }
}
