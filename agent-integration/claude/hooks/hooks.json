{
  "_comment": "PR 7 unit 7.24 (2026-04-20): per-hook timeout added; SubagentStart removed (not a valid Claude Code event — only SubagentStop exists). Plugin-bundled scripts resolve against ${CLAUDE_PLUGIN_ROOT} so the plugin works without requiring the fulcrum CLI to be on global PATH.",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude session-start", "timeout": 8 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude session-end", "timeout": 8 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude session-stop", "timeout": 8 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude subagent-stop", "timeout": 8 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude user-prompt-submit", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude pre-compact", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude notification", "timeout": 2 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Task|Grep|Glob|Read",
        "hooks": [
          { "type": "command", "command": "fulcrum hook auto", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Task",
        "hooks": [
          { "type": "command", "command": "fulcrum hook claude post", "timeout": 5 }
        ]
      }
    ]
  }
}
