{
  "name": "@fulcrum-agent-os/pi-cockpit",
  "version": "1.0.0",
  "description": "Fulcrum Cockpit — control-plane dashboard, task management, memory, lifecycle tools, and policy hook for the PI coding agent",
  "keywords": [
    "pi-package",
    "fulcrum",
    "agent-os",
    "task-management",
    "cockpit",
    "multi-agent"
  ],
  "author": "Fulcrum",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "git tag -s pi-cockpit/v$(node -p \"require('./package.json').version\") -m \"pi-cockpit v$(node -p \"require('./package.json').version\")\" && git push origin --tags"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.32.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moabualruz/fulcrum.git"
  },
  "homepage": "https://github.com/moabualruz/fulcrum#readme",
  "bugs": {
    "url": "https://github.com/moabualruz/fulcrum/issues"
  }
}
