{"id": "prd-tui-error-frame-recovery", "type": "feature", "surface": "tui", "area": "shell", "title": "Error frame and recovery path", "intent": "If screen render throws, TUI shows error message, logs trace, user can continue or quit", "sources": ["apps/tui/src/index.ts:render-error", "tests/tui/smoke.test.ts:204-240"], "acceptance": ["If screen.render() throws: error frame appears with message, stack trace (first 5 lines), route, screen key", "Error frame offers: 'Press [q] to quit, [r] to retry this screen, [b] to go back'", "Crash logged to disk: ~/.fulcrum/logs/crashes.jsonl with timestamp, error, context", "Telemetry recorded: error event sent to local telemetry sink", "User can retry: r attempts to re-render (helpful if error was transient)", "User can go back: b returns to previous screen", "User can quit: q exits TUI cleanly"], "anti_patterns": ["TUI hangs after render error (user must kill process)", "Error not logged (hard to debug)", "Error frame shows full stack trace (overwhelming)", "No recovery path (user must restart TUI)"], "interactions": [{"selector": "error:show", "action": "nav", "expected": "Error frame appears with message, route, screen key"}, {"selector": "error:retry", "action": "key", "expected": "r re-renders screen"}, {"selector": "error:back", "action": "key", "expected": "b returns to previous screen"}, {"selector": "error:quit", "action": "key", "expected": "q exits TUI"}], "critique_focus": "Is error message helpful? Can user recover? Is error logged for debugging?", "manual_simulation": "Trigger render error (e.g., corrupt screen config). See error frame. Try r (retry), b (back), q (quit).", "passes": false, "priority": "p1", "incentive": "reliability; errors are inevitable, recovery is essential", "status": "proposed", "op": "create", "agent": "seed-internal-tui", "ts": "2026-05-17T18:08:20.492762"}
