<script lang="ts">
  import { cn } from "@fulcrum/ui-kit";

  interface OperateSession {
    id: string;
    deviceType: string;
    browser: string;
    ipAddress: string | null;
    lastActiveAt: string;
    expiresAt: string;
    isCurrent: boolean;
  }

  const INITIAL_SESSIONS: OperateSession[] = [
    {
      id: "ses_current_macbook",
      deviceType: "desktop",
      browser: "Chrome",
      ipAddress: "10.0.1.0",
      lastActiveAt: "2026-05-19T08:24:11Z",
      expiresAt: "2026-05-26T08:24:11Z",
      isCurrent: true,
    },
    {
      id: "ses_remote_iphone",
      deviceType: "mobile",
      browser: "Safari",
      ipAddress: "100.64.7.0",
      lastActiveAt: "2026-05-19T06:42:00Z",
      expiresAt: "2026-05-26T06:42:00Z",
      isCurrent: false,
    },
    {
      id: "ses_remote_ipad",
      deviceType: "tablet",
      browser: "Safari",
      ipAddress: "100.64.10.0",
      lastActiveAt: "2026-05-18T22:08:00Z",
      expiresAt: "2026-05-25T22:08:00Z",
      isCurrent: false,
    },
    {
      id: "ses_automation_ci",
      deviceType: "automation",
      browser: "curl",
      ipAddress: "192.168.0.0",
      lastActiveAt: "2026-05-18T15:11:00Z",
      expiresAt: "2026-05-25T15:11:00Z",
      isCurrent: false,
    },
  ];

  let sessions = $state<OperateSession[]>(INITIAL_SESSIONS);
  let confirmTarget = $state<string | null>(null);
  let revokeLog = $state<string[]>([]);

  function requestRevoke(id: string): void {
    if (sessions.find((session) => session.id === id)?.isCurrent) return;
    confirmTarget = id;
  }

  function confirmRevoke(): void {
    if (!confirmTarget) return;
    const target = sessions.find((session) => session.id === confirmTarget);
    if (!target) return;
    revokeLog = [
      ...revokeLog,
      `revoked ${target.id} (${target.deviceType}/${target.browser}) at ${new Date().toISOString()}`,
    ];
    sessions = sessions.filter((session) => session.id !== confirmTarget);
    confirmTarget = null;
  }

  function dismissConfirm(): void {
    confirmTarget = null;
  }

  function revokeAllOthers(): void {
    const targets = sessions.filter((session) => !session.isCurrent);
    if (targets.length === 0) return;
    for (const target of targets) {
      revokeLog = [
        ...revokeLog,
        `revoked ${target.id} (${target.deviceType}/${target.browser}) at ${new Date().toISOString()}`,
      ];
    }
    sessions = sessions.filter((session) => session.isCurrent);
  }
</script>

<svelte:head>
  <title>Operate · Sessions | Fulcrum</title>
</svelte:head>

<section data-operate-alerts class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-4 py-12">
  <header class="flex flex-col gap-1">
    <h1 data-operate-alerts-header class="text-2xl font-semibold tracking-tight">Login sessions</h1>
    <p class="text-sm text-muted-foreground">
      Review devices, IP addresses, and last activity. Revoke individual or all remote sessions.
    </p>
  </header>

  <div class="flex items-center justify-between gap-3">
    <p data-operate-alerts-count class="text-sm text-muted-foreground">
      {sessions.length} active session{sessions.length === 1 ? "" : "s"}
    </p>
    <button
      type="button"
      data-revoke-other-sessions
      class={cn(
        "h-9 rounded-md border border-border px-3 text-sm font-medium hover:bg-muted",
        "disabled:cursor-not-allowed disabled:opacity-50",
      )}
      disabled={sessions.filter((session) => !session.isCurrent).length === 0}
      onclick={revokeAllOthers}
    >
      Revoke all other sessions
    </button>
  </div>

  <div class="overflow-x-auto rounded-md border border-border">
    <table data-operate-alerts-table class="w-full text-sm">
      <thead class="border-b border-border bg-muted/50">
        <tr>
          <th class="px-4 py-2 text-left font-medium">Device</th>
          <th class="px-4 py-2 text-left font-medium">Browser</th>
          <th class="px-4 py-2 text-left font-medium">IP</th>
          <th class="px-4 py-2 text-left font-medium">Last active</th>
          <th class="px-4 py-2 text-right font-medium">Actions</th>
        </tr>
      </thead>
      <tbody>
        {#each sessions as session (session.id)}
          <tr data-session-row={session.id} class="border-b border-border last:border-0">
            <td class="px-4 py-2">
              <div class="flex flex-col">
                <span class="font-medium">{session.deviceType}</span>
                {#if session.isCurrent}
                  <span data-current-session={session.id} class="text-xs text-success">current session</span>
                {:else}
                  <span class="font-mono text-xs text-muted-foreground">{session.id}</span>
                {/if}
              </div>
            </td>
            <td class="px-4 py-2 text-xs text-muted-foreground">{session.browser}</td>
            <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{session.ipAddress ?? "private"}</td>
            <td class="px-4 py-2 text-xs text-muted-foreground">{session.lastActiveAt}</td>
            <td class="px-4 py-2 text-right">
              {#if session.isCurrent}
                <button
                  type="button"
                  disabled
                  data-revoke-current-blocked={session.id}
                  class="rounded px-2 py-1 text-xs text-muted-foreground"
                >Current</button>
              {:else}
                <button
                  type="button"
                  data-revoke-session={session.id}
                  class="rounded px-2 py-1 text-xs text-destructive hover:bg-destructive/10"
                  onclick={() => requestRevoke(session.id)}
                >Revoke</button>
              {/if}
            </td>
          </tr>
        {/each}
      </tbody>
    </table>
  </div>

  {#if confirmTarget}
    <div
      data-revoke-confirm
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="revoke-confirm-title"
      class="rounded-md border border-destructive/40 bg-destructive/5 p-4"
    >
      <p id="revoke-confirm-title" class="text-sm font-medium">Revoke session?</p>
      <p class="text-xs text-muted-foreground">
        {confirmTarget} will be signed out on its device immediately.
      </p>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-revoke-confirm-yes
          class="h-9 rounded-md bg-destructive px-3 text-sm font-medium text-destructive-foreground"
          onclick={confirmRevoke}
        >Confirm revoke</button>
        <button
          type="button"
          data-revoke-confirm-cancel
          class="h-9 rounded-md border border-border px-3 text-sm"
          onclick={dismissConfirm}
        >Cancel</button>
      </div>
    </div>
  {/if}

  {#if revokeLog.length > 0}
    <section data-audit-log class="rounded-md border border-border p-3">
      <h2 class="text-sm font-medium">Audit log</h2>
      <ul class="mt-2 space-y-1 text-xs text-muted-foreground">
        {#each revokeLog as entry, index (entry + index)}
          <li data-audit-entry={index}>{entry}</li>
        {/each}
      </ul>
    </section>
  {/if}
</section>
